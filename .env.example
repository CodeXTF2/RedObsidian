# Copy to .env and fill in. Never commit .env.

# Public hostname Caddy serves (and gets a certificate for)
REDOBSIDIAN_DOMAIN=redobsidian.example.com

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
REDOBSIDIAN_SECRET_KEY=
POSTGRES_PASSWORD=

# Encrypts the nightly backups (12+ characters). Store it somewhere other than this server.
REDOBSIDIAN_BACKUP_PASSWORD=

# Optional
# REDOBSIDIAN_LOG_LEVEL=INFO
# REDOBSIDIAN_ALLOWED_ORIGINS=https://redobsidian.example.com   # only if the proxy rewrites the Host header
# REDOBSIDIAN_MAX_REQUEST_MB=1024                                  # hard cap; the per-upload limit is an admin setting
# REDOBSIDIAN_MAX_IMPORT_MB=4096

# Everything else (password policy, 2FA, lockout, SSO, retention, upload size) is set by an
# administrator in the web UI under Administration -> Security & settings, and is off by default.
